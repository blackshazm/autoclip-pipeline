# ==========================================
# PIPELINE AUTÔNOMO DE CORTES - CONFIGURAÇÕES
# ==========================================

# Diretórios e Banco
WATCH_DIR=./data/videos_longos
OUTPUT_DIR=./data/clips_exportados
DB_PATH=./data/pipeline.db
LOG_DIR=./logs
LOG_LEVEL=INFO

# Motor de Corte (Supoclip)
SUPOCLIP_API_URL=http://localhost:8000
SUPOCLIP_TIMEOUT_SECONDS=300
SUPOCLIP_MAX_RETRIES=3
MOCK_SUPOCLIP=false

# Limiares de Qualidade e Radar
MIN_VIRALITY_SCORE=70
VPH_MINIMUM_THRESHOLD=5000
RADAR_INTERVAL_MINUTES=15
RADAR_MIN_AGE_HOURS=2
RADAR_MAX_AGE_HOURS=48
RADAR_IGNORE_AFTER_DAYS=7
MAX_DOWNLOADS_PER_CYCLE=3
MAX_DAILY_DOWNLOADS=12

# Agendamento e Buffer Anti-Spam
TIMEZONE=America/Sao_Paulo
POST_INTERVAL_MINUTES=180
DEFAULT_POSTING_WINDOWS=["11:30","15:00","18:30","21:30"]
MAX_CLIP_AGE_DAYS=7

# Limpeza e Proteção de Disco
DISK_ALERT_THRESHOLD=75
DISK_HARD_THRESHOLD=85
EMERGENCY_CLEANUP_ENABLED=true
KEEP_POSTED_CLIPS_HOURS=72

# Credenciais YouTube e yt-dlp
# Modos disponíveis: 'api' (oficial via Google Cloud / 6 vídeos dia) ou 'browser' (Playwright / sem limites de cota de API)
YOUTUBE_PUBLISHER_MODE=api
YTDLP_COOKIES_PATH=./config/cookies.txt
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS=./config/client_secrets.json
YOUTUBE_TOKEN_PATH=./config/youtube_token.json
YOUTUBE_DATA_API_MAX_QUOTA_UNITS_PER_DAY=9000
YOUTUBE_DAILY_UPLOAD_LIMIT=6
YOUTUBE_BROWSER_HEADLESS=true
YOUTUBE_BROWSER_FALLBACK_TO_API=true

# Credenciais TikTok
TIKTOK_MODE=official
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# LLM / Copywriting (Hermes / OpenAI)
OPENAI_API_KEY=local-hermes
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=hermes-3-llama-3.1-8b
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=1

# Notificações e Webhooks
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
