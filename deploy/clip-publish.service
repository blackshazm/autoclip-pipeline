[Unit]
Description=Automacao de Cortes - Inteligencia e Publicacao
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/clip-automation
ExecStart=/opt/clip-automation/venv/bin/python -m src.robot2_publish
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
